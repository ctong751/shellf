{
  "name": "shellf",
  "version": "0.1.0",
  "description": "A small AT Protocol app built with TanStack Start and Cloudflare Workers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctong751/shellf.git"
  },
  "bugs": {
    "url": "https://github.com/ctong751/shellf/issues"
  },
  "homepage": "https://github.com/ctong751/shellf#readme",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm run db:up && pnpm run db:migrate && pnpm run dev:app",
    "dev:app": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run cf-typegen:check && pnpm run test",
    "preview": "pnpm run build && vite preview --host 127.0.0.1",
    "deploy": "pnpm run check && pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm run check && pnpm run build && wrangler deploy --dry-run",
    "db:up": "docker compose up --detach --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check"
  },
  "dependencies": {
    "@atproto/api": "^0.20.36",
    "@atproto/oauth-client-node": "^0.5.1",
    "@atproto/oauth-types": "^0.7.5",
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-router": "^1.168.34",
    "@tanstack/react-start": "^1.168.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.118.0"
  }
}
